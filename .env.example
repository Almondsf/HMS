# Copy to .env for local development. Every value has a safe local default,
# so .env is optional; production MUST set the ones marked [prod].

# --- Database: either a URL (hosting platforms) or the DB_* parts
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=hms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Core
# [prod] long random string: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# [prod] comma-separated hostnames (Render's own hostname is added automatically)
ALLOWED_HOSTS=
# Settings module: hms.settings.dev (default locally) | hms.settings.prod
# DJANGO_SETTINGS_MODULE=hms.settings.dev

# --- Multi-tenancy
# Hospitals live at <name>.<TENANT_BASE_DOMAIN> (needs a wildcard DNS record in production)
TENANT_BASE_DOMAIN=localhost
# Hostnames of the platform site itself; registered by `manage.py setup_platform`
PLATFORM_DOMAINS=localhost

# --- Browser frontends allowed to call the API (comma-separated origins)
CORS_ALLOWED_ORIGINS=
# Regex allow-list, e.g. ^https://[a-z0-9-]+\.hms\.app$ for every hospital's frontend
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=

# --- Security tuning (defaults shown)
# ADMIN_URL=admin/
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# THROTTLE_ANON=60/min
# THROTTLE_USER=2000/hour
# THROTTLE_LOGIN=10/min
# SECURE_HSTS_SECONDS=2592000
# API_DOCS_PUBLIC=False

# --- Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # json in production

# --- Error monitoring (optional; nothing identifying patients is sent)
# SENTRY_DSN=
# SENTRY_FRONTEND_DSN=
# SENTRY_ENVIRONMENT=production

# --- Email (password resets). Locally they print in the runserver console.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=HMS <no-reply@yourdomain.com>

# --- Branding: the product's name on the website, emails, admin and API docs
# PRODUCT_NAME=HMS

# --- Subscriptions (Paystack). Without a key, hospitals pay by bank transfer,
# which the platform records. Use sk_test_... until you go live.
# PAYSTACK_SECRET_KEY=
# SUBSCRIPTION_TRIAL_DAYS=14
# SUBSCRIPTION_GRACE_DAYS=7

# --- Self-serve signup (on the platform domain). Needs working email.
# THROTTLE_SIGNUP=5/hour
# SIGNUP_PROVISION_IN_BACKGROUND=True

# --- Patient SMS (appointment confirmations and reminders). Locally they print in the console.
# SMS_BACKEND=termii            # or africastalking; blank = off
# SMS_API_KEY=
# SMS_USERNAME=                 # Africa's Talking app username ("sandbox" for testing)
# SMS_SENDER_ID=                # registered with the provider
# SMS_MONTHLY_LIMIT_PER_HOSPITAL=500
# SMS_REMINDER_HOUR=9           # hospital time, the day before
