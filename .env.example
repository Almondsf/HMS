# Copy to .env for local development. Every value has a safe local default,
# so .env is optional; production MUST set the ones marked [prod].

# --- Database: either a URL (hosting platforms) or the DB_* parts
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=hms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Core
# [prod] long random string: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# [prod] comma-separated hostnames (Render's own hostname is added automatically)
ALLOWED_HOSTS=
# Settings module: hms.settings.dev (default locally) | hms.settings.prod
# DJANGO_SETTINGS_MODULE=hms.settings.dev

# --- Browser frontends allowed to call the API (comma-separated origins)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Security tuning (defaults shown)
# ADMIN_URL=admin/
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# THROTTLE_ANON=60/min
# THROTTLE_USER=2000/hour
# THROTTLE_LOGIN=10/min
# SECURE_HSTS_SECONDS=2592000
# API_DOCS_PUBLIC=False

# --- Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # json in production
