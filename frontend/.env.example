# Domain the hospitals live under: <hospital>.<VITE_TENANT_BASE_DOMAIN>
VITE_TENANT_BASE_DOMAIN=localhost

# Where each hospital's API is. {hospital} is replaced by the subdomain.
# Leave unset locally (http://<hospital>.localhost:8000); set "" when the API
# is served on the same domain as the frontend.
# VITE_API_URL=https://{hospital}.api.hms.app
